<Window x:Class="SecondScreen.Desktop.HealthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cek Kesehatan" Height="560" Width="500" MinHeight="480" MinWidth="460"
        Background="{StaticResource WindowBg}" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable, Segoe UI" ResizeMode="CanResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
        <TextBlock x:Name="TitleText" Text="Cek Kesehatan" Foreground="{StaticResource Fg}" FontSize="20" FontWeight="Bold"/>
        <TextBlock x:Name="SubtitleText" Text="Status komponen &amp; perbaikan cepat" Foreground="{StaticResource FgMuted}" FontSize="12" Margin="0,2,0,16"/>

        <!-- Driver row -->
        <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="DriverTitle" Text="Driver Layar 2" Foreground="{StaticResource Fg}" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DriverStatus" Text="memeriksa…" Foreground="{StaticResource FgMuted}" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
                <Button x:Name="DriverFixBtn" Grid.Column="1" Style="{StaticResource Pill}" Content="Perbaiki"
                        Click="DriverFix_Click" VerticalAlignment="Center" Width="110"/>
            </Grid>
        </Border>

        <!-- Test signing row -->
        <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TsTitle" Text="Test Signing Windows" Foreground="{StaticResource Fg}" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TsStatus" Text="memeriksa…" Foreground="{StaticResource FgMuted}" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
                <Button x:Name="TsEnableBtn" Grid.Column="1" Style="{StaticResource Pill}" Content="Aktifkan"
                        Click="TsEnable_Click" VerticalAlignment="Center" Width="110"/>
            </Grid>
        </Border>

        <!-- Network row -->
        <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="NetTitle" Text="Koneksi / Jaringan" Foreground="{StaticResource Fg}" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="NetStatus" Text="memeriksa…" Foreground="{StaticResource FgMuted}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="NetBtn" Grid.Column="1" Style="{StaticResource Pill}" Content="Buka Pengaturan Jaringan"
                        Click="NetOpen_Click" VerticalAlignment="Center" Width="110"/>
            </Grid>
        </Border>

        <!-- Danger: clean uninstall -->
        <Border Background="{StaticResource CardGrad}" BorderBrush="{StaticResource Danger}" BorderThickness="1"
                CornerRadius="16" Padding="16" Margin="0,4,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="UninstallLabel" Grid.Column="0" Text="Uninstall Bersih Driver" Foreground="{StaticResource Fg}"
                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button x:Name="UninstallBtn" Grid.Column="1" Style="{StaticResource Pill}" Content="Uninstall Bersih Driver"
                        Click="Uninstall_Click" Width="170" Foreground="{StaticResource Danger}"/>
            </Grid>
        </Border>

        <TextBlock x:Name="HealthLog" Foreground="{StaticResource FgMuted}" FontSize="11" TextWrapping="Wrap" Margin="2,0,0,12"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RefreshBtn" Style="{StaticResource Pill}" Content="Muat Ulang" Click="Refresh_Click" Width="120" Margin="0,0,10,0"/>
            <Button x:Name="CloseBtn" Style="{StaticResource Primary}" Content="Tutup" Click="Close_Click" Width="110"/>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
