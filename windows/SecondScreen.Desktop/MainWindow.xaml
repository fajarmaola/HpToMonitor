<Window x:Class="SecondScreen.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SecondScreen Local" Height="700" Width="460" MinHeight="560" MinWidth="440"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable, Segoe UI" ResizeMode="CanResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="SECOND SCREEN LOCAL" Foreground="{StaticResource Fg}"
                       FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Offline extended display for Android" Foreground="{StaticResource FgMuted}"
                       FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Status card -->
        <Border Grid.Row="1" Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,16">
            <StackPanel>
                <DockPanel Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="ANDROID DEVICE" Foreground="{StaticResource FgMuted}" FontSize="10"/>
                        <TextBlock x:Name="DeviceNameText" Text="—" Foreground="{StaticResource Fg}" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="{StaticResource AccentDim}" CornerRadius="20" Padding="12,5">
                        <TextBlock x:Name="StatusBadge" Text="DISCONNECTED" Foreground="{StaticResource FgMuted}"
                                   FontSize="11" FontWeight="Bold"/>
                    </Border>
                </DockPanel>

                <UniformGrid Columns="2" Margin="0,4,0,0">
                    <StackPanel Margin="0,6">
                        <TextBlock Text="CONNECTION" Foreground="{StaticResource FgMuted}" FontSize="10"/>
                        <TextBlock x:Name="ConnText" Text="—" Foreground="{StaticResource Fg}" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Margin="0,6">
                        <TextBlock Text="RESOLUTION" Foreground="{StaticResource FgMuted}" FontSize="10"/>
                        <TextBlock x:Name="ResText" Text="—" Foreground="{StaticResource Fg}" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Margin="0,6">
                        <TextBlock Text="FPS" Foreground="{StaticResource FgMuted}" FontSize="10"/>
                        <TextBlock x:Name="FpsText" Text="—" Foreground="{StaticResource Fg}" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Margin="0,6">
                        <TextBlock Text="LATENCY" Foreground="{StaticResource FgMuted}" FontSize="10"/>
                        <TextBlock x:Name="LatencyText" Text="—" Foreground="{StaticResource Accent}" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Margin="0,6">
                        <TextBlock Text="BITRATE" Foreground="{StaticResource FgMuted}" FontSize="10"/>
                        <TextBlock x:Name="BitrateText" Text="—" Foreground="{StaticResource Fg}" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Margin="0,6">
                        <TextBlock Text="CODEC" Foreground="{StaticResource FgMuted}" FontSize="10"/>
                        <TextBlock x:Name="CodecText" Text="H.264" Foreground="{StaticResource Fg}" FontSize="14"/>
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- Settings / PIN area -->
        <StackPanel Grid.Row="2">
            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="PERFORMANCE" Foreground="{StaticResource FgMuted}" FontSize="10" Margin="0,0,0,6"/>
                    <ComboBox x:Name="QualityCombo" SelectedIndex="1" Height="34" Foreground="Black">
                        <ComboBoxItem>Performance</ComboBoxItem>
                        <ComboBoxItem>Balanced</ComboBoxItem>
                        <ComboBoxItem>High Quality</ComboBoxItem>
                    </ComboBox>
                    <CheckBox x:Name="VirtualDisplayCheck" Content="Create virtual Display 2 (IddCx driver)"
                              Foreground="{StaticResource Fg}" Margin="0,12,0,0" IsChecked="True"/>
                    <CheckBox x:Name="EncryptVideoCheck" Content="Encrypt video stream (AES-256-GCM)"
                              Foreground="{StaticResource Fg}" Margin="0,8,0,0" IsChecked="True"/>
                    <CheckBox x:Name="HwEncodeCheck" Content="Prefer hardware H.264 encoder"
                              Foreground="{StaticResource Fg}" Margin="0,8,0,0" IsChecked="True"/>
                </StackPanel>
            </Border>

            <!-- PIN card (visible only while pairing) -->
            <Border x:Name="PinCard" Visibility="Collapsed" Background="{StaticResource Card}"
                    BorderBrush="{StaticResource Warn}" BorderThickness="1" CornerRadius="14" Padding="18">
                <StackPanel>
                    <TextBlock x:Name="PinPromptText" Text="A device wants to connect. Enter this code on Android:"
                               Foreground="{StaticResource FgMuted}" FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock x:Name="PinText" Text="— — —   — — —" Foreground="{StaticResource Warn}"
                               FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="LogText" Foreground="{StaticResource FgMuted}" FontSize="11"
                       TextWrapping="Wrap" Margin="2,12,0,0"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,16,0,0">
            <Button x:Name="StartButton" Style="{StaticResource Primary}" Content="Start Hosting"
                    Click="StartButton_Click" Width="140" Margin="0,0,10,0"/>
            <Button x:Name="DisconnectButton" Style="{StaticResource Pill}" Content="Disconnect"
                    Click="DisconnectButton_Click" Width="120" Margin="0,0,10,0" IsEnabled="False"/>
            <Button Style="{StaticResource Pill}" Content="Display Settings"
                    Click="DisplaySettings_Click" Width="150"/>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
