<Window x:Class="SecondScreen.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HP ke Monitor" Height="720" Width="460" MinHeight="560" MinWidth="440"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable, Segoe UI" ResizeMode="CanResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="HP KE MONITOR" Foreground="{StaticResource Fg}"
                       FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Ubah HP jadi layar kedua PC — offline" Foreground="{StaticResource FgMuted}"
                       FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Status card -->
        <Border Grid.Row="1" Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,16">
            <StackPanel>
                <DockPanel Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="PERANGKAT ANDROID" Foreground="{StaticResource FgMuted}" FontSize="10"/>
                        <TextBlock x:Name="DeviceNameText" Text="—" Foreground="{StaticResource Fg}" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="{StaticResource AccentDim}" CornerRadius="20" Padding="12,5">
                        <TextBlock x:Name="StatusBadge" Text="DISCONNECTED" Foreground="{StaticResource FgMuted}"
                                   FontSize="11" FontWeight="Bold"/>
                    </Border>
                </DockPanel>

                <UniformGrid Columns="2" Margin="0,4,0,0">
                    <StackPanel Margin="0,6">
                        <TextBlock Text="KONEKSI" Foreground="{StaticResource FgMuted}" FontSize="10"/>
                        <TextBlock x:Name="ConnText" Text="—" Foreground="{StaticResource Fg}" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Margin="0,6">
                        <TextBlock Text="RESOLUSI" Foreground="{StaticResource FgMuted}" FontSize="10"/>
                        <TextBlock x:Name="ResText" Text="—" Foreground="{StaticResource Fg}" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Margin="0,6">
                        <TextBlock Text="FPS" Foreground="{StaticResource FgMuted}" FontSize="10"/>
                        <TextBlock x:Name="FpsText" Text="—" Foreground="{StaticResource Fg}" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Margin="0,6">
                        <TextBlock Text="LATENSI" Foreground="{StaticResource FgMuted}" FontSize="10"/>
                        <TextBlock x:Name="LatencyText" Text="—" Foreground="{StaticResource Accent}" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Margin="0,6">
                        <TextBlock Text="BITRATE" Foreground="{StaticResource FgMuted}" FontSize="10"/>
                        <TextBlock x:Name="BitrateText" Text="—" Foreground="{StaticResource Fg}" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Margin="0,6">
                        <TextBlock Text="CODEC" Foreground="{StaticResource FgMuted}" FontSize="10"/>
                        <TextBlock x:Name="CodecText" Text="H.264" Foreground="{StaticResource Fg}" FontSize="14"/>
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- Settings / PIN area -->
        <StackPanel Grid.Row="2">
            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="PERFORMA" Foreground="{StaticResource FgMuted}" FontSize="10" Margin="0,0,0,6"/>
                    <ComboBox x:Name="QualityCombo" SelectedIndex="1" Height="34" Foreground="Black">
                        <ComboBoxItem>Hemat (lancar)</ComboBoxItem>
                        <ComboBoxItem>Seimbang</ComboBoxItem>
                        <ComboBoxItem>Kualitas Tinggi</ComboBoxItem>
                    </ComboBox>
                    <CheckBox x:Name="VirtualDisplayCheck" Content="Buat Layar 2 virtual (driver IddCx)"
                              Foreground="{StaticResource Fg}" Margin="0,12,0,0" IsChecked="True"/>
                    <CheckBox x:Name="EncryptVideoCheck" Content="Enkripsi aliran video (AES-256-GCM)"
                              Foreground="{StaticResource Fg}" Margin="0,8,0,0" IsChecked="True"/>
                    <CheckBox x:Name="HwEncodeCheck" Content="Utamakan encoder H.264 hardware"
                              Foreground="{StaticResource Fg}" Margin="0,8,0,0" IsChecked="True"/>
                </StackPanel>
            </Border>

            <!-- PIN card (visible only while pairing) -->
            <Border x:Name="PinCard" Visibility="Collapsed" Background="{StaticResource Card}"
                    BorderBrush="{StaticResource Warn}" BorderThickness="1" CornerRadius="14" Padding="18">
                <StackPanel>
                    <TextBlock x:Name="PinPromptText" Text="Sebuah perangkat ingin terhubung. Masukkan kode ini di Android:"
                               Foreground="{StaticResource FgMuted}" FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock x:Name="PinText" Text="— — —   — — —" Foreground="{StaticResource Warn}"
                               FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="LogText" Foreground="{StaticResource FgMuted}" FontSize="11"
                       TextWrapping="Wrap" Margin="2,12,0,0"/>
        </StackPanel>

        <!-- Buttons + driver status + company footer -->
        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="DriverStatusText" Text="Driver Layar 2: memeriksa…"
                       Foreground="{StaticResource FgMuted}" FontSize="11" Margin="2,0,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                <Button x:Name="StartButton" Style="{StaticResource Primary}" Content="Pasang &amp; Mulai"
                        Click="StartButton_Click" Width="150" Margin="0,0,10,0"/>
                <Button x:Name="DisconnectButton" Style="{StaticResource Pill}" Content="Putuskan"
                        Click="DisconnectButton_Click" Width="110" Margin="0,0,10,0" IsEnabled="False"/>
                <Button Style="{StaticResource Pill}" Content="Pengaturan Layar"
                        Click="DisplaySettings_Click" Width="150"/>
            </StackPanel>
            <TextBlock Text="PT Teleraya Digital Group  •  company.teleraya.com"
                       Foreground="{StaticResource FgMuted}" FontSize="11" Opacity="0.7"
                       HorizontalAlignment="Center" Margin="0,14,0,0"/>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
