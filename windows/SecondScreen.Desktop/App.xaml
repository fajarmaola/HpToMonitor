<Application x:Class="SecondScreen.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Dark, technical, minimal theme (UI DESIGN section of the spec) -->
        <SolidColorBrush x:Key="Bg" Color="#0E1116"/>
        <SolidColorBrush x:Key="Card" Color="#161B22"/>
        <SolidColorBrush x:Key="CardBorder" Color="#232A34"/>
        <SolidColorBrush x:Key="Fg" Color="#E6EDF3"/>
        <SolidColorBrush x:Key="FgMuted" Color="#8B949E"/>
        <SolidColorBrush x:Key="Accent" Color="#2ED47A"/>
        <SolidColorBrush x:Key="AccentDim" Color="#1B3A2A"/>
        <SolidColorBrush x:Key="Danger" Color="#F85149"/>
        <SolidColorBrush x:Key="Warn" Color="#E3B341"/>

        <Style TargetType="Button" x:Key="Pill">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1E2530"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="Primary" BasedOn="{StaticResource Pill}">
            <Setter Property="Background" Value="{StaticResource AccentDim}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        </Style>
    </Application.Resources>
</Application>
