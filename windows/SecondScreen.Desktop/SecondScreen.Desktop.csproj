<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>SecondScreen.Desktop</RootNamespace>
    <AssemblyName>SecondScreenLocal</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>appicon.ico</ApplicationIcon>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="assets\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SecondScreen.Core\SecondScreen.Core.csproj" />
  </ItemGroup>

  <!-- Bundle the built driver package next to the exe under "driver\" so the app can install it
       in one step (DriverInstaller). Build the driver first (or set SSL_DRIVER_DIR). Silently
       skipped when the package isn't present (e.g. Core-only dev builds). -->
  <ItemGroup>
    <None Include="..\SecondScreen.DisplayDriver\x64\Release\SecondScreen.DisplayDriver\**\*"
          Condition="Exists('..\SecondScreen.DisplayDriver\x64\Release\SecondScreen.DisplayDriver')">
      <Link>driver\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(SSL_DRIVER_DIR)\**\*"
          Condition="'$(SSL_DRIVER_DIR)' != '' And Exists('$(SSL_DRIVER_DIR)')">
      <Link>driver\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Copy the native DLL next to the exe. Build SecondScreen.Native first (docs/BUILD_WINDOWS.md).
       Override the path with the SSL_NATIVE_DLL env var if you built it elsewhere. -->
  <ItemGroup>
    <None Include="$(SSL_NATIVE_DLL)" Condition="'$(SSL_NATIVE_DLL)' != ''">
      <Link>SecondScreen.Native.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\SecondScreen.Native\build\Release\SecondScreen.Native.dll"
          Condition="'$(SSL_NATIVE_DLL)' == '' And Exists('..\SecondScreen.Native\build\Release\SecondScreen.Native.dll')">
      <Link>SecondScreen.Native.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
