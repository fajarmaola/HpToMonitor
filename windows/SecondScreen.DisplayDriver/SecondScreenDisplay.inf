; SecondScreenDisplay.inf — IddCx indirect display driver for SecondScreen Local.
; Install: pnputil /add-driver SecondScreenDisplay.inf /install   (see docs/DRIVER_SETUP.md)
; Structure mirrors Microsoft's official IddSampleDriver.inf (DIRID 12\UMDF + WUDFRD includes),
; which passes InfVerif on the current WDK (no DIRID-13 rule, no manual WUDFRd service).

[Version]
PnpLockdown = 1
Signature   = "$WINDOWS NT$"
Class       = Display
ClassGuid   = {4d36e968-e325-11ce-bfc1-08002be10318}
ClassVer    = 2.0
Provider    = %ManufacturerName%
CatalogFile = SecondScreenDisplay.cat
DriverVer   = ; set by stampinf

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...17763

[Standard.NT$ARCH$.10.0...17763]
%DeviceName% = SecondScreenDisplay_Install, Root\SecondScreenDisplay

[SourceDisksFiles]
SecondScreenDisplay.dll = 1

[SourceDisksNames]
1 = %DiskName%

; =================== UMDF / IddCx Device ==================================

[SecondScreenDisplay_Install.NT]
Include   = WUDFRD.inf
Needs     = WUDFRD.NT
CopyFiles = UMDriverCopy

[SecondScreenDisplay_Install.NT.hw]
Include = WUDFRD.inf
Needs   = WUDFRD.NT.HW
AddReg  = SecondScreenDisplay_HardwareDeviceSettings

[SecondScreenDisplay_HardwareDeviceSettings]
; IddCx reflector requires the IndirectKmd kernel-mode component as an upper filter.
HKR,, "UpperFilters", %REG_MULTI_SZ%, "IndirectKmd"
HKR, "WUDF", "DeviceGroupId", %REG_SZ%, "SecondScreenDisplayGroup"

[SecondScreenDisplay_Install.NT.Services]
Include = WUDFRD.inf
Needs   = WUDFRD.NT.Services

[SecondScreenDisplay_Install.NT.Wdf]
UmdfService                = SecondScreenDisplay, SecondScreenDisplay_UmdfInstall
UmdfServiceOrder           = SecondScreenDisplay
UmdfKernelModeClientPolicy = AllowKernelModeClients

[SecondScreenDisplay_UmdfInstall]
UmdfLibraryVersion = 2.25.0
ServiceBinary      = %12%\UMDF\SecondScreenDisplay.dll
; IddCx0102 is the FIXED registered name of the IddCx UMDF class extension — it stays "IddCx0102"
; even for IddCx 1.4/1.6 drivers (Microsoft's official IddSampleDriver uses IddCx0102). Declaring a
; version-specific name like IddCx0104 makes Windows unable to find the extension, so the driver
; fails to load with Device Manager "Code 31 / STATUS_UNSUCCESSFUL".
UmdfExtensions     = IddCx0102

[DestinationDirs]
UMDriverCopy = 12,UMDF ; copy to drivers\umdf

[UMDriverCopy]
SecondScreenDisplay.dll

[Strings]
ManufacturerName = "PT Teleraya Digital Group"
DeviceName       = "HP ke Monitor — Layar Virtual"
DiskName         = "HP ke Monitor — Media Instalasi"
REG_MULTI_SZ     = 0x00010000
REG_SZ           = 0x00000000
